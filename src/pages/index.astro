---
import BaseLayout from '../layouts/BaseLayout.astro';

const investments = [
  'Alongside',
  'AngelList',
  'Arcol',
  'Badaboom',
  'Betr',
  'Break the Love',
  'CareRev',
  'Clever Harvest',
  'Cosy',
  'Haus',
  'Infinity Constellation',
  'MainStreet',
  'Motion',
  'On Deck',
  'Pareto',
  'Range',
  'Rewind AI',
  'Secureframe',
  'The Essential',
];
---

<BaseLayout
  title="Lin Group"
  description="Private investment and holding company."
  canonical="https://lingroup.us"
>
  <section class="home">
    <h1>Lin Group</h1>
    <p class="descriptor">Private investment and holding company.</p>
    <p>
      Lin Group engages in selective investments and related activities across technology, consumer, and other sectors.
    </p>
  </section>

  <section class="investments" aria-labelledby="investments-heading">
    <h2 id="investments-heading">Select investments</h2>
    <ul class="investment-grid" role="list">
      {investments.map((name) => <li class="investment">{name}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .home {
    max-width: 41rem;
    margin: clamp(5rem, 13vh, 9rem) auto clamp(4.5rem, 11vh, 7.5rem);
    text-align: left;
  }

  h1 {
    margin-bottom: 0.85rem;
    letter-spacing: 0.01em;
    font-weight: 650;
  }

  .descriptor {
    color: var(--color-text-muted);
    font-size: 1.03rem;
    line-height: 1.6;
    margin-bottom: 1.7rem;
  }

  .home p {
    max-width: 39rem;
  }

  .investments {
    max-width: 41rem;
    margin: 0 auto clamp(5rem, 12vh, 8rem);
  }

  .investments h2 {
    margin-bottom: 1.5rem;
    font-size: var(--text-base);
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .investment-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    gap: 0.8rem 2rem;
  }

  .investment {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  @media (max-width: 42rem) {
    .home {
      margin-top: 4rem;
      margin-bottom: 4.5rem;
    }

    .investment-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }

  @media (max-width: 27rem) {
    .investment-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
